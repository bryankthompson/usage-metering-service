#!/usr/bin/env bash
# Run the test suite against a throwaway Postgres 16 (docker). One container is shared; each checkout
# gets its own database inside it, so a worktree and a reviewer can run at the same time.
# If DATABASE_URL is already set, it is used as it is. Extra arguments go to pytest.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -z "${DATABASE_URL:-}" ]; then
  NAME=${TEST_DB_NAME:-metering-test-db}
  PORT=${TEST_DB_PORT:-5455}
  if ! docker ps --format '{{.Names}}' | grep -qx "$NAME"; then
    docker rm -f "$NAME" >/dev/null 2>&1 || true
    docker run -d --name "$NAME" -e POSTGRES_USER=metering -e POSTGRES_PASSWORD=metering \
      -e POSTGRES_DB=metering -p "127.0.0.1:$PORT:5432" postgres:16 >/dev/null
    echo "started $NAME on port $PORT"
  fi
  if docker port "$NAME" 5432/tcp | grep -qv '^127\.0\.0\.1:'; then
    echo "$NAME publishes its port beyond loopback (older container); run: docker rm -f $NAME, then rerun" >&2
    exit 1
  fi
  until docker exec "$NAME" pg_isready -U metering -h 127.0.0.1 >/dev/null 2>&1; do sleep 1; done
  DB="metering_$(pwd | md5sum | cut -c1-8)"
  if ! docker exec "$NAME" psql -U metering -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='$DB'" | grep -q 1; then
    docker exec "$NAME" psql -U metering -d postgres -c "CREATE DATABASE $DB" >/dev/null
  fi
  export DATABASE_URL="postgresql://metering:metering@localhost:$PORT/$DB"
fi
echo "tests use $DATABASE_URL"
exec uv run --frozen pytest -q "$@"
